# Copie para .env e ajuste os valores em produção.
# cp .env.example .env

# Chave secreta Flask (sessões, CSRF). Gere uma string aleatória longa.
SECRET_KEY=altere-esta-chave-em-producao

# Base de dados SQLAlchemy
# Dev (default): SQLite local
# DATABASE_URL=sqlite:///pc_health.db
# Produção (exemplo PostgreSQL):
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/pc_health

# Limite mensal do plano FREE
# FREE_REPORTS_PER_MONTH=5
